# Project-level Kconfig defaults. Applied when sdkconfig is regenerated.
# Manual edits to sdkconfig override these.

# Custom partition table (adds coredump partition for panic dumps).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# GOOUUU ESP32-S3-CAM (WROOM-1 N16R8) has 16 MB flash — was 2 MB on
# SuperMini. Spare space beyond partitions.csv is reserved for future
# EPD font/asset partitions.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Core dump to flash — survives reboot, readable via idf.py coredump-info.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# docs/48 Tier 1: TLS client + httpd concurrent sockets headroom (was 10)
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MAX_ACTIVE_TCP=16
CONFIG_LWIP_MAX_LISTENING_TCP=16
